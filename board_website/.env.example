# =====================================================================
# Job Tracker Environment Configuration
# =====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Storage Provider: 'local' (default) or 'google_drive'
STORAGE_PROVIDER=google_drive

# Local Storage
DB_PATH=./tracker.db
UPLOAD_DIR=./documents
MAX_FILE_SIZE_MB=25

# Google Drive Cloud Storage Configuration
# (Note: Google Drive folder is linked per-user in Career Profile UI)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Optional Security PIN (Leave blank for open local access, or set e.g. 1234)
APP_PIN=

# Turso Cloud SQLite Database (Required for Vercel/Serverless deployment, optional for local)
# Sign up and create a free database at: https://turso.tech
# CLI: turso db create job-tracker-db && turso db show job-tracker-db --url && turso db tokens create job-tracker-db
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-jwt

# JWT Secret for Session Authentication (Change to a random secure string in production)
JWT_SECRET=job-tracker-secure-secret-key-change-in-production

# Google OAuth Credentials (Web Client)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web Application)
# Authorized redirect URI: http://localhost:3000/auth/google/callback (or your production Vercel domain)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Desktop OAuth Credentials (Optional: Desktop Application Client ID)
GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=your-desktop-client-secret

# SMTP Mailer Configuration (Password Resets & Notifications)
# For Gmail: Use smtp.gmail.com with a 16-character Google App Password (not your normal password)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Job Tracker <your-email@gmail.com>"
