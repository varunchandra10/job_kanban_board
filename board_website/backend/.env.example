# Server Configuration
PORT=3000
NODE_ENV=development

# Storage Provider: 'local' (default) or 'google_drive'
STORAGE_PROVIDER=local

# Local Storage
DB_PATH=./tracker.db
UPLOAD_DIR=./documents
MAX_FILE_SIZE_MB=25

# Google Drive Cloud Storage Configuration
# (Note: Google Drive folder is compulsory and linked per-user in Career Profile UI)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Optional Security PIN (Leave blank for open local access, or set e.g. 1234)
APP_PIN=

# Turso Cloud Database (Optional for local, required for Vercel cloud deployment)
# Get a free 9GB database at https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=your-secure-jwt-secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Desktop OAuth Credentials
GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=your-desktop-client-secret

# SMTP Mailer Configuration (Password Resets & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Job Tracker <your-email@gmail.com>"


