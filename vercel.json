{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "board_website/backend",
      "framework": "express"
    },
    "frontend": {
      "root": "board_website/frontend",
      "framework": "vite"
    }
  },
  "crons": [
    {
      "path": "/api/learnings/streak-reminder-check?slot=lunch",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/learnings/streak-reminder-check?slot=dinner",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
