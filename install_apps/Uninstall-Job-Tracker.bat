@echo offecho =====================================================echo           Job Tracker Uninstallerecho =====================================================echo.echo Stopping any running Job Tracker processes...taskkill /F /IM JobTracker.exe 2>nultaskkill /F /IM Job-Tracker-Setup.exe 2>nultaskkill /F /IM app.exe 2>nulecho Removing desktop shortcuts...del "%USERPROFILE%\Desktop\Job Tracker.lnk" 2>nuldel "%PUBLIC%\Desktop\Job Tracker.lnk" 2>nulecho Removing Start Menu shortcuts...del "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Job Tracker.lnk" 2>nulecho Removing app files from LocalAppData...rmdir /S /Q "%LOCALAPPDATA%\Programs\Job Tracker" 2>nulrmdir /S /Q "%LOCALAPPDATA%\Programs\Job-Tracker" 2>nulecho Removing installation registry entries...reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Uninstall\JobTracker" /f 2>nulecho.echo =====================================================echo  Job Tracker has been cleanly uninstalled.echo =====================================================pause